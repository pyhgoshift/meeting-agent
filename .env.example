# ── AI 분석 (NVIDIA NIM — DeepSeek v4 Pro) ───────────────
NVIDIA_API_KEY=                    # NVIDIA NIM API 키
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

# ── 음성 변환 (Groq — Whisper large-v3-turbo, 무료) ──────
GROQ_API_KEY=                      # Groq API 키 (console.groq.com)
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Slack ─────────────────────────────────────────────────
SLACK_BOT_TOKEN=                   # Bot OAuth 토큰 (xoxb-)
SLACK_CHANNEL_ID=                  # 결과를 보낼 채널 ID

# ── Notion ────────────────────────────────────────────────
NOTION_API_KEY=                    # Notion Integration 토큰
NOTION_DATABASE_ID=                # 회의록 저장 DB ID

# ── Google Calendar (2단계 추가 예정) ─────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ── 서버 ──────────────────────────────────────────────────
PORT=3000
